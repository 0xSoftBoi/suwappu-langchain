{
  "name": "@suwappu/langchain-suwappu",
  "version": "0.2.0",
  "description": "Production-oriented LangChain tools for Suwappu quotes, simulation, self-custody preparation, and approval-gated managed execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE",
    "SKILL.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:package",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xSoftBoi/suwappu-langchain"
  },
  "homepage": "https://github.com/0xSoftBoi/suwappu-langchain#readme",
  "keywords": ["langchain", "suwappu", "dex", "ai-agent", "tools", "defi", "trading"],
  "author": "Suwappu",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.5",
    "langchain": "^1.5.5"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.5",
    "@types/node": "^24.10.0",
    "langchain": "^1.5.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
